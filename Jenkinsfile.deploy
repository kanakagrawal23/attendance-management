pipeline {
    agent any

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['Staging', 'Production'], description: 'Target environment')
        string(name: 'BUILD_NUMBER_PARAM', defaultValue: '1', description: 'ECR image tag to deploy')
    }

    environment {
        AWS_REGION   = 'ap-south-1'
        ECR_REGISTRY = '595365650066.dkr.ecr.ap-south-1.amazonaws.com'
        ECR_REPO     = '595365650066.dkr.ecr.ap-south-1.amazonaws.com/attendance-management'
        EC2_HOST     = '3.109.62.241'
        EC2_USER     = 'ec2-user'
        CONTAINER    = 'attendance'
    }

    stages {
        stage('Deploy to EC2') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-credentials',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    sshagent(credentials: ['ec2-ssh-key']) {
                        bat """
                            ssh -o StrictHostKeyChecking=no %EC2_USER%@%EC2_HOST% ^
                            "aws ecr get-login-password --region %AWS_REGION% ^| docker login --username AWS --password-stdin %ECR_REGISTRY% && ^
                            docker pull %ECR_REPO%:${params.BUILD_NUMBER_PARAM} && ^
                            docker stop %CONTAINER% 2>nul || exit /b 0"
                        """

                        bat """
                            ssh -o StrictHostKeyChecking=no %EC2_USER%@%EC2_HOST% ^
                            "docker rm %CONTAINER% 2>nul || exit /b 0"
                        """

                        bat """
                            ssh -o StrictHostKeyChecking=no %EC2_USER%@%EC2_HOST% ^
                            "docker run -d --name %CONTAINER% --restart unless-stopped -p 8081:8081 %ECR_REPO%:${params.BUILD_NUMBER_PARAM}"
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo "========================================="
            echo "DEPLOYMENT SUCCESS"
            echo "Environment : ${params.ENVIRONMENT}"
            echo "EC2 Host    : ${EC2_HOST}"
            echo "Image Tag   : ${params.BUILD_NUMBER_PARAM}"
            echo "========================================="
        }
        failure {
            echo "========================================="
            echo "DEPLOYMENT FAILED"
            echo "Environment : ${params.ENVIRONMENT}"
            echo "EC2 Host    : ${EC2_HOST}"
            echo "Image Tag   : ${params.BUILD_NUMBER_PARAM}"
            echo "Console     : ${BUILD_URL}"
            echo "========================================="
        }
        always {
            cleanWs()
        }
    }
}