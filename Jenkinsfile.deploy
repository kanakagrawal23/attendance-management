pipeline {
    agent any

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['Staging', 'Production'], description: 'Target environment')
        string(name: 'BUILD_NUMBER_PARAM', defaultValue: '1', description: 'ECR image tag to deploy')
    }

    environment {
        AWS_REGION   = 'ap-south-1'
        ECR_REGISTRY = '595365650066.dkr.ecr.ap-south-1.amazonaws.com'
        ECR_REPO     = '595365650066.dkr.ecr.ap-south-1.amazonaws.com/attendance-management'
        EC2_HOST     = '3.109.62.241'
        EC2_USER     = 'ec2-user'
        CONTAINER    = 'attendance'
    }

    stages {
        stage('Deploy to EC2') {
            steps {
                withCredentials([
                    file(credentialsId: 'ec2-ssh-key', variable: 'PEM_FILE'),
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-credentials',
                        accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                        secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                    ]
                ]) {
                    script {
                        writeFile file: 'deploy.sh', text: '''
#!/bin/bash
set -e

echo "Logging into ECR..."
aws ecr get-login-password --region ap-south-1 | docker login --username AWS --password-stdin 595365650066.dkr.ecr.ap-south-1.amazonaws.com

echo "Pulling image..."
docker pull 595365650066.dkr.ecr.ap-south-1.amazonaws.com/attendance-management:'"${BUILD_NUMBER_PARAM}"'

echo "Stopping old container if exists..."
docker stop attendance || true
docker rm attendance || true

echo "Running new container..."
docker run -d --name attendance --restart unless-stopped -p 8081:8080 595365650066.dkr.ecr.ap-south-1.amazonaws.com/attendance-management:'"${BUILD_NUMBER_PARAM}"'

echo "Deployment completed."
docker ps
'''

                        bat '''
                            icacls "%PEM_FILE%" /inheritance:r
                            icacls "%PEM_FILE%" /remove:g "BUILTIN\\Users"
                            icacls "%PEM_FILE%" /remove:g "NT AUTHORITY\\Authenticated Users"
                            icacls "%PEM_FILE%" /remove:g "Everyone"
                            icacls "%PEM_FILE%" /grant:r "NT AUTHORITY\\SYSTEM:R"
                            icacls "%PEM_FILE%" /grant:r "BUILTIN\\Administrators:R"

                            ssh -o StrictHostKeyChecking=no -i "%PEM_FILE%" %EC2_USER%@%EC2_HOST% "mkdir -p /tmp/jenkins-deploy"
                            if errorlevel 1 exit /b 1

                            scp -o StrictHostKeyChecking=no -i "%PEM_FILE%" deploy.sh %EC2_USER%@%EC2_HOST%:/tmp/jenkins-deploy/deploy.sh
                            if errorlevel 1 exit /b 1

                            ssh -o StrictHostKeyChecking=no -i "%PEM_FILE%" %EC2_USER%@%EC2_HOST% "chmod +x /tmp/jenkins-deploy/deploy.sh && bash /tmp/jenkins-deploy/deploy.sh"
                            if errorlevel 1 exit /b 1
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo "========================================="
            echo "DEPLOYMENT SUCCESS"
            echo "Environment : ${params.ENVIRONMENT}"
            echo "EC2 Host    : ${env.EC2_HOST}"
            echo "Image Tag   : ${params.BUILD_NUMBER_PARAM}"
            echo "========================================="
        }
        failure {
            echo "========================================="
            echo "DEPLOYMENT FAILED"
            echo "Environment : ${params.ENVIRONMENT}"
            echo "EC2 Host    : ${env.EC2_HOST}"
            echo "Image Tag   : ${params.BUILD_NUMBER_PARAM}"
            echo "Console     : ${env.BUILD_URL}"
            echo "========================================="
        }
        always {
            cleanWs()
        }
    }
}